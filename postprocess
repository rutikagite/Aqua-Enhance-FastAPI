import cv2
import numpy as np
from PIL import Image, ImageEnhance, ImageFilter

def advanced_postprocess_output(output_tensor, original_size, CONFIG):
    """
    Advanced post-processing pipeline for sharper, clearer underwater images
    
    Args:
        output_tensor: Model output tensor (torch.Tensor)
        original_size: Tuple (width, height) for final image
        CONFIG: Configuration dictionary with enhancement parameters
    
    Returns:
        PIL.Image: Enhanced image with advanced post-processing
    """
    import torch
    
    # Convert tensor to numpy
    output = output_tensor.squeeze(0).cpu().detach()
    
    # CLCC uses Tanh activation, so output is in [-1, 1]
    # Map to [0, 1] range
    output = (output + 1) / 2.0
    output = torch.clamp(output, 0, 1)
    
    # Convert to HWC format (Height, Width, Channels)
    output_np = output.numpy().transpose(1, 2, 0)
    output_np = (output_np * 255).astype(np.uint8)
    
    # Convert to PIL image
    enhanced_image = Image.fromarray(output_np)
    
    # Resize to original dimensions using high-quality LANCZOS
    enhanced_image = enhanced_image.resize(original_size, Image.LANCZOS)
    
    # --- ADVANCED POST-PROCESSING PIPELINE ---
    
    # 1. UNSHARP MASKING for better sharpness
    # Apply gaussian blur and subtract from original
    blurred = enhanced_image.filter(ImageFilter.GaussianBlur(radius=1.5))
    enhanced_array = np.array(enhanced_image, dtype=np.float32)
    blurred_array = np.array(blurred, dtype=np.float32)
    
    # Unsharp mask: original + amount * (original - blurred)
    unsharp_amount = 1.5
    sharpened_array = enhanced_array + unsharp_amount * (enhanced_array - blurred_array)
    sharpened_array = np.clip(sharpened_array, 0, 255).astype(np.uint8)
    enhanced_image = Image.fromarray(sharpened_array)
    
    # 2. DETAIL ENHANCEMENT using high-pass filter
    detail = enhanced_image.filter(ImageFilter.DETAIL)
    enhanced_image = Image.blend(enhanced_image, detail, 0.3)
    
    # 3. COLOR ENHANCEMENT (boost saturation)
    enhancer_color = ImageEnhance.Color(enhanced_image)
    enhanced_image = enhancer_color.enhance(CONFIG.get('color_enhance', 1.7))
    
    # 4. CONTRAST ENHANCEMENT using adaptive method
    # First apply global contrast
    enhancer_contrast = ImageEnhance.Contrast(enhanced_image)
    enhanced_image = enhancer_contrast.enhance(CONFIG.get('contrast_enhance', 1.25))
    
    # Then apply local contrast enhancement (CLAHE)
    enhanced_array = np.array(enhanced_image)
    lab = cv2.cvtColor(enhanced_array, cv2.COLOR_RGB2LAB)
    l, a, b = cv2.split(lab)
    
    # Apply CLAHE to L channel
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    l = clahe.apply(l)
    
    lab = cv2.merge([l, a, b])
    enhanced_array = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)
    enhanced_image = Image.fromarray(enhanced_array)
    
    # 5. FINAL SHARPNESS BOOST
    enhancer_sharp = ImageEnhance.Sharpness(enhanced_image)
    enhanced_image = enhancer_sharp.enhance(CONFIG.get('sharpness_enhance', 1.4))
    
    # 6. EDGE ENHANCEMENT for better clarity
    edges = enhanced_image.filter(ImageFilter.EDGE_ENHANCE_MORE)
    enhanced_image = Image.blend(enhanced_image, edges, 0.2)
    
    # 7. NOISE REDUCTION (optional - helps with smoother results)
    enhanced_array = np.array(enhanced_image)
    denoised = cv2.fastNlMeansDenoisingColored(enhanced_array, None, 5, 5, 7, 21)
    enhanced_image = Image.fromarray(denoised)
    
    return enhanced_image


def simple_sharpen_postprocess(output_tensor, original_size, CONFIG):
    """
    Simpler but effective post-processing focused on sharpness
    Use this if the advanced version is too aggressive
    
    Args:
        output_tensor: Model output tensor (torch.Tensor)
        original_size: Tuple (width, height) for final image
        CONFIG: Configuration dictionary with enhancement parameters
    
    Returns:
        PIL.Image: Enhanced image with sharpness-focused post-processing
    """
    import torch
    
    # Convert tensor to numpy
    output = output_tensor.squeeze(0).cpu().detach()
    output = (output + 1) / 2.0
    output = torch.clamp(output, 0, 1)
    
    output_np = output.numpy().transpose(1, 2, 0)
    output_np = (output_np * 255).astype(np.uint8)
    
    enhanced_image = Image.fromarray(output_np)
    enhanced_image = enhanced_image.resize(original_size, Image.LANCZOS)
    
    # --- SIMPLE BUT EFFECTIVE PIPELINE ---
    
    # 1. Unsharp mask for better edge definition
    blurred = enhanced_image.filter(ImageFilter.GaussianBlur(radius=2.0))
    enhanced_array = np.array(enhanced_image, dtype=np.float32)
    blurred_array = np.array(blurred, dtype=np.float32)
    
    sharpened_array = enhanced_array + 2.0 * (enhanced_array - blurred_array)
    sharpened_array = np.clip(sharpened_array, 0, 255).astype(np.uint8)
    enhanced_image = Image.fromarray(sharpened_array)
    
    # 2. Color enhancement
    enhancer_color = ImageEnhance.Color(enhanced_image)
    enhanced_image = enhancer_color.enhance(CONFIG.get('color_enhance', 1.8))
    
    # 3. Contrast enhancement
    enhancer_contrast = ImageEnhance.Contrast(enhanced_image)
    enhanced_image = enhancer_contrast.enhance(CONFIG.get('contrast_enhance', 1.3))
    
    # 4. Sharpness boost
    enhancer_sharp = ImageEnhance.Sharpness(enhanced_image)
    enhanced_image = enhancer_sharp.enhance(CONFIG.get('sharpness_enhance', 1.6))
    
    # 5. Edge enhancement
    enhanced_image = enhanced_image.filter(ImageFilter.EDGE_ENHANCE)
    
    return enhanced_image


